generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

enum SignalSide {
    BUY
    SELL
    HOLD
}

model Signal {
    id         Int        @id @default(autoincrement())
    asset      String
    side       SignalSide
    confidence Int
    price      Float
    timestamp  BigInt
    createdAt  DateTime   @default(now())
    updatedAt  DateTime   @updatedAt

    @@index([createdAt])
    @@index([asset])
    @@index([side])
}
